# Copy this file to ".env" (the README and TEAMSETUP.md both say to). Restart "npm run dev" after editing.

# Address of the Laravel API. Default: http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

# Address placed inside generated QR codes. Leave empty to use the page's own address.
# For same-Wi-Fi phone testing, set this to your computer's address, e.g. http://192.168.1.5:5173
VITE_PUBLIC_APP_URL=
